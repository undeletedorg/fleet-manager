# Copy to .env and fill in. .env is never committed.
#
# inventory.json refers to these as ${FLEET_DOMAIN} and friends. A real
# environment variable of the same name overrides this file, and anything
# left undefined is named in the error rather than silently blank.

# DNS suffix for management addresses, e.g. host01.mgmt.example.internal
FLEET_DOMAIN=mgmt.example.internal

# SSH user for the coding hosts.
FLEET_SSH_USER=youruser

# One URL per compose service you register, named to match its "url" field.
# examples/inventory.json uses SERVICE_URL for its example-app service.
SERVICE_URL=http://10.0.0.10
